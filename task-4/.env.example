# Copy to `.env` in this directory (see README.md).
# Primary spec names (preferred). Legacy ATC_* names in README still work.

# --- Required (official task.md variables) ---
RUNWAY_COUNT=2
GATE_COUNT=3
GROUND_CREW_COUNT=4
RUNWAY_LENGTHS=2800,3200

TAKEOFF_BUFFER_MINUTES=2
LANDING_BUFFER_MINUTES=2
MIXED_OPERATION_BUFFER_MINUTES=3

GATE_TURNAROUND_MINUTES=5
DEPENDENCY_BUFFER_MINUTES=15
MAX_SCHEDULING_HORIZON_MINUTES=800

# --- Optional operation durations (modeling assumptions; defaults shown) ---
# ARRIVAL_RUNWAY_BLOCK_MINUTES=10
# DEPARTURE_RUNWAY_BLOCK_MINUTES=10
# ARRIVAL_GATE_BLOCK_MINUTES=20
# DEPARTURE_GATE_BLOCK_MINUTES=20
#
# Example overrides (uncomment to tune segment lengths):
# ARRIVAL_RUNWAY_BLOCK_MINUTES=5
# DEPARTURE_RUNWAY_BLOCK_MINUTES=5
# ARRIVAL_GATE_BLOCK_MINUTES=20
# DEPARTURE_GATE_BLOCK_MINUTES=25
